#!/usr/bin/env bash
set -euo pipefail

die() {
  printf 'oyo-portable-system-creator: error: %s\n' "$*" >&2
  exit 1
}

script_entry="${BASH_SOURCE[0]}"
[[ -L "${script_entry}" ]] && die "refusing to start through a symbolic link: ${script_entry}"
script_path="$(readlink -f -- "${script_entry}")" || die "cannot resolve launcher path: ${script_entry}"
[[ "${script_path##*/}" == "oyo-portable-system-creator" ]] || die "unexpected launcher name: ${script_path##*/}"
script_dir="$(cd -- "$(dirname -- "${script_path}")" && pwd -P)" || die "cannot resolve launcher directory"

is_app_root() {
  local root="$1"
  [[ -d "${root}/src" && ! -L "${root}/src" &&
     -d "${root}/src/gui" && ! -L "${root}/src/gui" &&
     -f "${root}/src/__init__.py" && ! -L "${root}/src/__init__.py" &&
     -f "${root}/src/gui/__init__.py" && ! -L "${root}/src/gui/__init__.py" &&
     -f "${root}/src/gui/main_window.py" && ! -L "${root}/src/gui/main_window.py" ]]
}

resolve_app_root() {
  local root

  case "${script_dir}" in
    */src/bin)
      root="$(cd -- "${script_dir}/../.." 2>/dev/null && pwd -P)" ||
        die "cannot resolve source checkout root from ${script_dir}"
      if [[ ! -f "${root}/debian/control" || ! -f "${root}/debian/install" ]] || ! is_app_root "${root}"; then
        die "launcher is under src/bin, but ${root} is not a valid source checkout"
      fi
      printf '%s\n' "${root}"
      ;;
    */usr/bin)
      root="$(cd -- "${script_dir}/../share/oyo-portable-system-creator" 2>/dev/null && pwd -P)" ||
        die "cannot resolve installed application root from ${script_dir}"
      if ! is_app_root "${root}"; then
        die "installed application at ${root} is incomplete (src.gui.main_window is missing)"
      fi
      printf '%s\n' "${root}"
      ;;
    *)
      die "unsupported launcher location ${script_path}; expected a source checkout's src/bin or an installed usr/bin location"
      ;;
  esac
}

app_root="$(resolve_app_root)"
python_entrypoint='import os, sys; app_root = sys.argv[1]; os.chdir(app_root); sys.path.insert(0, app_root); from src.gui.main_window import run_gui; raise SystemExit(run_gui())'

if [[ "$(id -u)" -ne 0 ]]; then
  exec pkexec env \
    -u PYTHONHOME \
    -u PYTHONUSERBASE \
    -u PYTHONPATH \
    DISPLAY="${DISPLAY:-}" \
    XAUTHORITY="${XAUTHORITY:-${HOME:-}/.Xauthority}" \
    LANG="${LANG:-}" \
    LANGUAGE="${LANGUAGE:-}" \
    LC_ALL="${LC_ALL:-}" \
    LC_MESSAGES="${LC_MESSAGES:-}" \
    PYTHONPATH="${app_root}" \
    PYTHONNOUSERSITE=1 \
    python3 -s -c "${python_entrypoint}" "${app_root}"
fi

cd -- "${app_root}"
unset PYTHONHOME PYTHONUSERBASE
export PYTHONPATH="${app_root}"
export PYTHONNOUSERSITE=1
exec python3 -s -c "${python_entrypoint}" "${app_root}"
